# Copy to .env and change as needed. All settings are optional.

# BASEPOINT (FSS) API base URL
FSS_API_URL=https://api.hospitality.reliatech.co.ke

# Timeout in seconds for one BASEPOINT request
FSS_TIMEOUT_SECONDS=90

# Comma-separated keys for the HTTP API (header X-API-Key). Empty: no key required.
API_KEYS=

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
